    border-radius: 16px;
    padding: 24px 20px;
    cursor: pointer;
    background-color: #f8fafc;
    transition: border-color 0.2s, background-color 0.2s, border-style 0.2s;
}
.dropzone-premium:not(.locked):hover {
    border-color: #D65A20;
    background-color: rgba(214, 90, 32, 0.02);
}
.btn-batal {
    padding: 12px 32px;
    border-radius: 30px;
