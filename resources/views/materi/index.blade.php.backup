            }
            if (!$fallbackGuruId && isset($materials) && $materials->isNotEmpty()) {
                $fallbackGuruId = $materials->first()->guru_id;
            }
            if (!$fallbackGuruId) {
                $fallbackGuruId = 1;
            }
            
            $selectedSubjectIdForModal = request('subject_id') ?? ($subjects->first()->id ?? null);
